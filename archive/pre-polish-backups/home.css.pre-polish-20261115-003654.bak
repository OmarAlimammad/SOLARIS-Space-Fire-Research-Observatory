.hero-section{position:relative;overflow:hidden;background:linear-gradient(110deg,#f7fafd 0%,#f2f8fc 57%,#ebf5fb 100%);padding:80px 0 36px}.hero-haze{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 48% 76% at 79% 38%,rgba(152,216,252,.22),transparent 75%)}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.02fr .98fr;gap:45px;align-items:center;min-height:590px}.hero-copy{padding:15px 0 30px}.hero-kicker{display:inline-flex;align-items:center;gap:11px;color:#3f80aa;letter-spacing:.19em;font-size:10.4px;font-weight:800;margin-bottom:28px}.hero-kicker-pip{width:8px;height:8px;background:#2daadd;border:2px solid #d6f0ff;box-shadow:0 0 0 3px #caeaff;border-radius:50%}.hero-kicker-index{color:#9eb2c5}.hero-copy h1{font-family:Manrope,sans-serif;font-size:clamp(52px,5.25vw,78px);line-height:1.13;letter-spacing:-.075em;font-weight:800;color:#0e304d;margin:0 0 30px}.hero-copy h1 em{font-style:normal;color:#2185c7}.hero-h1-underline{position:relative;white-space:nowrap}.hero-h1-underline:after{content:'';position:absolute;left:1%;right:0;bottom:-7px;height:5px;background:#8ed2f1;opacity:.75;transform:rotate(-2deg);border-radius:100%}.hero-description{font-size:15px;color:#58748a;line-height:1.9;max-width:505px;margin-bottom:35px}.hero-cta-row{display:flex;gap:12px;flex-wrap:wrap}.hero-evidence{display:flex;align-items:center;gap:13px;margin-top:44px;font-size:11px;font-weight:800;color:#54768c;line-height:1.65}.hero-evidence small{font-size:10px;color:#95a9ba;font-weight:600}.hero-evidence-icon{width:31px;height:31px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#138b9b;background:#dff7f6;border:1px solid #b9e5e4}.hero-visual{border:1px solid #cfe1ed;box-shadow:0 25px 60px rgba(45,91,136,.13),0 4px 13px rgba(45,91,136,.06);border-radius:15px;overflow:hidden;background:linear-gradient(145deg,#fafdff 0%,#e8f5fc 100%);position:relative}.hero-visual:before{content:'';position:absolute;inset:0;pointer-events:none;border:5px solid rgba(255,255,255,.38);border-radius:15px}.hero-visual-topline,.hero-visual-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:18px 24px;color:#6887a0;font-size:10px;letter-spacing:.11em;font-weight:800}.hero-visual-topline{border-bottom:1px solid #d7e8f1}.hero-visual-topline>span:first-child{display:flex;align-items:center;gap:8px;color:#2c6e9c}.signal-pip,.micro-dot{height:6px;width:6px;background:#19abae;border-radius:100%;display:inline-block;box-shadow:0 0 0 3px #d8f2f1}.hero-flame-stage{height:425px;position:relative;overflow:hidden}.flame-svg{width:100%;height:100%;display:block}.flame-orbit{animation:orbital 17s linear infinite;transform-origin:center}.flame-core{animation:flamebreathe 4.5s ease-in-out infinite;transform-origin:340px 236px}@keyframes flamebreathe{50%{transform:scale(1.035);opacity:.92}}@keyframes orbital{50%{transform:rotate(7deg)}}.stage-left-label{position:absolute;top:60px;left:25px;z-index:2;display:flex;flex-direction:column;gap:4px;font-size:9px;letter-spacing:.17em;color:#7ca0b9}.stage-left-label strong{font-size:10px;color:#367eab;letter-spacing:.08em}.stage-corner-label{position:absolute;right:25px;bottom:28px;font-size:9px;line-height:1.7;letter-spacing:.14em;text-align:right;color:#83a3b8;font-weight:800}.hero-visual-controls{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 23px 15px}.visual-control-caption{font-size:10px;letter-spacing:.13em;color:#6792ae;font-weight:800}.visual-toggle,.tab-set{display:inline-flex;gap:3px;padding:4px;border:1px solid #cde1ef;background:#eaf4fa;border-radius:7px}.visual-toggle button,.tab-set button{border:0;background:transparent;color:#6d8ba1;font-weight:800;font-size:11px;padding:10px 13px;border-radius:5px;transition:background .2s,color .2s}.visual-toggle button.selected,.tab-set button.selected{background:#fff;color:#126bad;box-shadow:0 1px 7px #5d9cbe20}.hero-visual-foot{border-top:1px solid #d7e8f1;padding:15px 24px;font-size:9px;color:#91a8b8}.hero-visual-foot>span:first-child{display:flex;align-items:center;gap:11px;color:#588ca8}.hero-scroll-note{position:relative;z-index:1;display:flex;align-items:center;gap:12px;color:#759ab4;letter-spacing:.16em;font-size:10px;font-weight:800;margin-top:24px}.data-band{background:#0b314d;color:#e9f7ff}.data-band-inner{min-height:136px;display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr .86fr;gap:20px;align-items:center}.data-band-title{display:flex;align-items:center;gap:11px;color:#99bcd2;line-height:1.7;font-size:10px;letter-spacing:.13em;font-weight:800}.band-stripe{width:4px;height:30px;background:#54b4df}.data-band-stat{display:flex;flex-direction:column;gap:3px}.data-band-stat strong{font-family:Manrope,sans-serif;font-size:27px;font-weight:800;letter-spacing:-.04em}.data-band-stat span{font-size:10px;color:#9fbad0;letter-spacing:.02em}.data-band-link{display:flex;justify-content:flex-end}.data-band-link a{display:flex;align-items:center;gap:9px;color:#afe6fd;font-size:10px;font-weight:800;letter-spacing:.1em}.science-intro{background:#fff}.science-grid{display:grid;grid-template-columns:.84fr 1.16fr;align-items:center;gap:80px}.science-copy .section-heading p{max-width:410px}.science-copy .text-link{margin-top:18px}.science-compare{display:grid;grid-template-columns:1fr 1fr;gap:15px}.compare-card{background:#f6f9fc;border:1px solid #e0eaf2;border-radius:12px;padding:21px;min-height:314px;display:flex;flex-direction:column}.compare-card-head{display:flex;align-items:center;gap:9px;color:#5f7b91;letter-spacing:.11em;font-size:9.5px;font-weight:800}.compare-card-head svg{margin-left:auto;color:#6495b4}.compare-n{display:inline-flex;align-items:center;justify-content:center;border:1px solid #c8dbe8;border-radius:4px;width:24px;height:24px;font-size:9px}.small-flame{height:167px;position:relative;display:flex;align-items:center;justify-content:center}.small-flame:before{content:'';width:125px;height:125px;position:absolute;border:1px dashed #c7dce9;border-radius:50%}.small-flame:after{content:'';position:absolute;bottom:15px;width:73px;height:3px;border-radius:4px;background:#9dbacb}.flame-drawn-earth{width:73px;height:113px;border-radius:58% 43% 60% 47% / 75% 65% 36% 42%;background:radial-gradient(ellipse at 47% 75%,#ecfdff 9%,#b6effd 29%,#6bc7ed 66%,#458cbf 100%);clip-path:polygon(50% 0,82% 29%,100% 74%,92% 100%,5% 100%,0 74%,24% 40%);filter:drop-shadow(0 0 16px #b5e8f9)}.flame-arrow{position:absolute;right:20px;top:35px;color:#7eafcf;font-size:38px}.flame-drawn-micro{width:113px;height:113px;border-radius:50%;background:radial-gradient(circle at 46% 40%,#f0fdff 0%,#d8f8fe 21%,#8dd9fa 42%,#5ea8df 70%,#badff2 95%);box-shadow:0 0 34px #bbecff}.compare-blue{background:linear-gradient(145deg,#edf8fd,#f5fbff);border-color:#cfe6f5}.compare-footer strong{font-size:13px;color:#1a4769}.compare-footer p{font-size:11px;line-height:1.7;color:#68879d;margin:7px 0 0}.compare-disclaimer{grid-column:span 2;color:#90a4b5;font-size:10px;line-height:1.6}.capability-section{background:#f4f8fb;border-top:1px solid #edf2f6;border-bottom:1px solid #eaf1f6}.capability-head{display:flex;justify-content:space-between;gap:30px;align-items:end}.capability-head .section-heading p{max-width:575px}.link-align{margin-bottom:26px;flex-shrink:0}.capability-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}.capability-card{display:flex;flex-direction:column;border:1px solid #e0eaf2;border-radius:13px;background:#fff;overflow:hidden;min-height:440px;box-shadow:0 8px 22px rgba(25,64,91,.035);transition:transform .25s,border-color .25s,box-shadow .25s}.capability-card:hover{transform:translateY(-7px);border-color:#aed7ef;box-shadow:0 20px 36px rgba(25,64,91,.085)}.capability-top{padding:22px 23px 12px;display:flex;justify-content:space-between;color:#64859d;font-size:10px;letter-spacing:.11em;font-weight:800}.capability-art{height:163px;display:flex;align-items:center;justify-content:center;position:relative;background:linear-gradient(140deg,#f4faff 0%,#e9f5fd 100%);margin:0 15px;border:1px solid #e6f0f7;border-radius:9px}.mini-chart{width:85%;height:127px}.art-tag{position:absolute;bottom:9px;right:13px;color:#8aaec5;font-size:8px;letter-spacing:.11em;font-weight:800}.capability-bottom{padding:25px;display:flex;flex:1;flex-direction:column;align-items:flex-start}.capability-bottom>svg{color:#247db2}.capability-bottom h3{font-size:19px;line-height:1.35;letter-spacing:-.045em;color:#103650;margin:16px 0 12px}.capability-bottom p{font-size:12.5px;color:#71879a;line-height:1.8;margin-bottom:22px}.capability-footer{display:flex;gap:9px;align-items:center;color:#1879bc;margin-top:auto;font-size:10px;font-weight:800;letter-spacing:.1em}.journey-section{background:linear-gradient(115deg,#0d3654,#0a2f4b);color:#d9edfa;position:relative;overflow:hidden}.journey-section:before{content:'';position:absolute;width:520px;height:520px;border:1px solid #3e799644;border-radius:50%;left:-240px;bottom:-300px;box-shadow:0 0 0 90px #4b8eb00a,0 0 0 180px #6ac8f008}.journey-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:94px;position:relative;z-index:1;align-items:center}.journey-left h2{font-size:clamp(33px,4vw,49px);line-height:1.25;letter-spacing:-.059em;color:#fff;margin:23px 0}.journey-left h2 em{font-style:normal;color:#7bd1f5}.journey-left>p{font-size:14px;line-height:1.9;color:#aec9db;margin-bottom:30px}.journey-right{border-top:1px solid #39617a}.journey-step{border-bottom:1px solid #39617a;padding:24px 0;display:grid;grid-template-columns:34px 1fr 24px;gap:19px;align-items:start}.journey-step>span{font-family:Manrope;font-size:15px;color:#69bde9;font-weight:800}.journey-step strong{color:#fff;font-size:16px}.journey-step p{margin:9px 0 0;color:#a6c5d9;font-size:12px;line-height:1.7}.journey-step>svg{color:#79c7f0}.cta-section{background:#fff;padding:92px 0}.cta-shell{min-height:390px;background:linear-gradient(110deg,#eef8fe,#dff2fd);border:1px solid #cfe6f5;border-radius:15px;padding:66px 75px;position:relative;overflow:hidden;display:flex;align-items:center}.cta-content{position:relative;z-index:2}.cta-content h2{font-size:clamp(35px,4vw,54px);letter-spacing:-.06em;line-height:1.17;margin:21px 0}.cta-content h2 em{font-style:normal;color:#2583bd}.cta-content>p{font-size:14px;color:#5e8199;line-height:1.8;max-width:450px;margin-bottom:27px}.cta-orbit{position:absolute;width:540px;height:540px;border-radius:50%;border:1px solid #78bedf;opacity:.26;right:-84px;top:-83px}.cta-orbit-2{width:350px;height:350px;right:11px;top:14px;opacity:.45}.cta-symbol{font-family:Manrope;font-weight:800;font-size:280px;line-height:1;color:#3b9cd4;opacity:.11;position:absolute;right:50px;top:40px;transform:rotate(-15deg)}.cta-symbol span{color:#67cddf}
@media (max-width:1120px){.hero-grid{gap:22px}.hero-copy h1{font-size:60px}.hero-flame-stage{height:370px}.data-band-inner{gap:18px}.science-grid{gap:40px}}@media (max-width:900px){.hero-grid{grid-template-columns:1fr;gap:50px}.hero-section{padding-top:62px}.hero-copy{padding-bottom:0}.hero-copy h1{font-size:clamp(50px,8vw,72px)}.hero-description{max-width:650px}.hero-visual{max-width:690px;width:100%;margin-inline:auto}.hero-scroll-note{margin-top:24px}.data-band-inner{grid-template-columns:repeat(4,1fr);padding:29px 0}.data-band-title{grid-column:span 4}.data-band-link{justify-content:flex-start}.science-grid,.journey-grid{grid-template-columns:1fr;gap:43px}.science-copy .section-heading p{max-width:680px}.science-compare{max-width:660px}.capability-grid{gap:12px}.capability-card{min-height:460px}.capability-bottom{padding:18px}.capability-bottom h3{font-size:17px}.journey-right{max-width:680px}}@media (max-width:700px){.hero-section{padding:50px 0 26px}.hero-copy h1{font-size:clamp(42px,10vw,57px);letter-spacing:-.07em}.hero-description{font-size:14px}.hero-kicker{font-size:9px;letter-spacing:.12em}.hero-cta-row{display:grid;grid-template-columns:1fr;max-width:330px}.hero-evidence{margin-top:29px}.hero-flame-stage{height:290px}.stage-left-label{top:25px;left:16px}.stage-corner-label{right:14px;bottom:8px}.hero-visual-topline,.hero-visual-foot{padding:14px 15px;font-size:8px}.hero-visual-controls{padding:9px 12px 13px}.visual-control-caption{font-size:8px}.visual-toggle button{padding:9px 8px;font-size:10px}.data-band-inner{grid-template-columns:repeat(2,1fr);gap:25px 15px}.data-band-title{grid-column:span 2}.data-band-stat strong{font-size:23px}.data-band-link{justify-content:flex-start}.science-compare{gap:9px}.compare-card{padding:12px;min-height:297px}.compare-card-head{font-size:8px}.compare-n{display:none}.small-flame{height:145px}.flame-arrow{right:6px}.compare-footer strong{font-size:12px}.compare-footer p{font-size:10px}.capability-head{display:block}.link-align{margin-top:12px}.capability-grid{grid-template-columns:1fr;gap:17px}.capability-card{min-height:0}.capability-art{height:178px}.capability-bottom{padding:24px}.capability-bottom h3{font-size:21px}.capability-bottom p{font-size:13px}.journey-grid{gap:36px}.journey-left h2{font-size:34px}.journey-step{grid-template-columns:27px 1fr 18px;gap:10px}.journey-step strong{font-size:14px}.cta-section{padding:65px 0}.cta-shell{padding:41px 28px;min-height:340px}.cta-symbol{font-size:160px;top:95px;right:-10px}}


/* =====================================================
   SOLARIS HOME V2 — SCIENTIFIC EDITORIAL DESIGN
   Append after existing home.css styles.
   ===================================================== */

.obs-home {
  background: #fff;
  color: #102f49;
  overflow: hidden;
}

.obs-home * {
  box-sizing: border-box;
}

.obs-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .17em;
  color: #347eae;
  text-transform: uppercase;
}

.obs-eyebrow-line {
  width: 27px;
  height: 2px;
  background: #2d91cf;
  flex: 0 0 auto;
}

.obs-home h1,
.obs-home h2,
.obs-home h3 {
  font-family: Manrope, sans-serif;
}

.obs-home h2 {
  font-size: clamp(37px, 4vw, 61px);
  line-height: 1.16;
  letter-spacing: -.065em;
  font-weight: 800;
}

.obs-home h2 em {
  font-style: normal;
  color: #2785c0;
}

.obs-home a {
  text-decoration: none;
}

.obs-button-primary,
.obs-button-secondary,
.obs-button-light {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 17px 22px;
  min-height: 54px;
  border-radius: 7px;
  font-weight: 800;
  font-size: 12px;
  transition: background .2s, transform .2s, border-color .2s;
}

.obs-button-primary {
  color: #fff !important;
  background: #177dbd;
  border: 1px solid #177dbd;
}

.obs-button-primary:hover {
  background: #0e5e93;
  transform: translateY(-2px);
}

.obs-button-secondary {
  color: #184c70 !important;
  background: #fff;
  border: 1px solid #bfd8e8;
}

.obs-button-secondary:hover {
  border-color: #177dbd;
}

.obs-button-light {
  background: #f6fbff;
  color: #17486b !important;
  align-self: flex-start;
}

.obs-text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #1678b8 !important;
  font-size: 13px;
  font-weight: 800;
  border-bottom: 1px solid #8cc2e3;
  padding-bottom: 10px;
}

/* HERO */

.obs-hero {
  position: relative;
  background: #f5f9fc;
  padding: 84px 0 36px;
}

.obs-hero-grid {
  display: grid;
  grid-template-columns: .96fr 1.04fr;
  gap: clamp(30px, 4.5vw, 90px);
  align-items: center;
}

.obs-hero-copy {
  padding: 10px 0;
}

.obs-hero-copy h1 {
  font-size: clamp(55px, 5.5vw, 88px);
  letter-spacing: -.082em;
  line-height: 1.08;
  margin: 29px 0;
  color: #0c304d;
  font-weight: 800;
}

.obs-hero-copy h1 em {
  color: #267fb7;
  font-style: normal;
}

.obs-hero-description {
  font-size: 15px;
  line-height: 1.95;
  max-width: 520px;
  color: #5e788d;
  margin: 0 0 30px;
}

.obs-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.obs-hero-note {
  position: relative;
  margin-top: 48px;
  padding-left: 22px;
  font-size: 11px;
  line-height: 1.85;
  color: #66839a;
}

.obs-note-rule {
  position: absolute;
  left: 0;
  top: 3px;
  height: 31px;
  width: 3px;
  background: #87c8e9;
}

/* HERO PHOTOGRAPHY */

.obs-hero-figure {
  margin: 0;
  border: 1px solid #d4e3ed;
  background: #fff;
  padding: 10px;
  box-shadow: 0 24px 60px rgba(18, 57, 83, .09);
}

.obs-photo-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 9px;
  letter-spacing: .13em;
  font-weight: 800;
  color: #67879a;
  padding: 12px 13px 18px;
}

.obs-photo-frame {
  position: relative;
  background: #05070d;
  height: clamp(390px, 36vw, 560px);
  overflow: hidden;
}

.obs-photo-frame img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
}

.obs-photo-index {
  position: absolute;
  bottom: 18px;
  left: 18px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #fff;
  font-size: 10px;
  letter-spacing: .12em;
  font-weight: 800;
  text-shadow: 0 2px 10px #000;
}

.obs-photo-index span {
  color: #b5d1e5;
  font-size: 9px;
}

.obs-photo-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 12px 10px;
}

.obs-photo-caption > span {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.obs-photo-caption strong {
  font-size: 13px;
  color: #143852;
}

.obs-photo-caption small {
  font-size: 11px;
  color: #7893a7;
}

.obs-photo-caption a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #207bb4;
  font-size: 10px;
  letter-spacing: .1em;
  font-weight: 800;
}

.obs-scroll {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-top: 45px;
  color: #7593aa;
  font-size: 10px;
  letter-spacing: .15em;
  font-weight: 800;
}

/* DATA STRIP */

.obs-data-strip {
  background: #0d324d;
  color: #fff;
}

.obs-data-inner {
  min-height: 129px;
  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr 1fr auto;
  gap: 24px;
  align-items: center;
}

.obs-data-label {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #a4c5d9;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .12em;
}

.obs-data-line {
  width: 3px;
  height: 35px;
  background: #5bb9e6;
}

.obs-data-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.obs-data-item strong {
  color: #fff;
  font-size: 26px;
  letter-spacing: -.055em;
}

.obs-data-item span {
  font-size: 10px;
  color: #a4bfce;
}

.obs-source-link {
  display: flex;
  gap: 8px;
  align-items: center;
  color: #b0e5fa !important;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
}

/* GRAVITY SECTION */

.obs-science {
  padding: 125px 0;
  background: #fff;
}

.obs-science-grid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: clamp(35px, 6vw, 115px);
  align-items: center;
}

.obs-science-heading h2 {
  margin: 25px 0 27px;
}

.obs-science-heading > p {
  font-size: 14px;
  line-height: 1.95;
  color: #637f92;
  max-width: 480px;
}

.obs-science-heading .obs-text-link {
  margin-top: 23px;
}

.obs-comparison-figure {
  margin: 0;
  border: 1px solid #dce9f1;
  background: #f8fbfd;
  padding: 20px;
}

.obs-figure-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 17px;
  font-size: 10px;
  font-weight: 800;
  color: #5e86a2;
  letter-spacing: .12em;
}

.obs-comparison-figure img {
  width: 100%;
  display: block;
  height: auto;
  background: #060b17;
}

.obs-comparison-figure figcaption {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-bottom: 1px solid #dce7ef;
}

.obs-comparison-figure figcaption > div {
  padding: 17px 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.obs-comparison-figure figcaption > div + div {
  border-left: 1px solid #dce7ef;
}

.obs-comparison-figure figcaption strong {
  font-size: 13px;
  color: #143b58;
}

.obs-comparison-figure figcaption span {
  font-size: 11px;
  color: #69869b;
}

.obs-figure-credit {
  font-size: 10px;
  color: #7990a1;
  line-height: 1.7;
  margin: 15px 2px 0;
}

.obs-figure-credit a {
  color: #1878b4;
  text-decoration: underline;
}

/* FEATURED RESEARCH */

.obs-featured {
  padding: 110px 0;
  background: #f1f7fb;
}

.obs-featured-head {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
  margin-bottom: 39px;
}

.obs-featured-head > span:last-child {
  font-size: 9px;
  color: #88a2b4;
  letter-spacing: .15em;
}

.obs-featured-grid {
  display: grid;
  grid-template-columns: 1.03fr .97fr;
  gap: 65px;
  align-items: stretch;
}

.obs-featured-copy {
  padding: 18px 0;
}

.obs-small-label {
  color: #2985bf;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .15em;
}

.obs-featured-copy h2 {
  margin: 24px 0;
}

.obs-featured-copy > p {
  color: #647f92;
  font-size: 14px;
  line-height: 1.9;
  max-width: 560px;
}

.obs-featured-facts {
  border-top: 1px solid #d4e3eb;
  margin-top: 35px;
}

.obs-featured-facts > div {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 20px;
  padding: 16px 0;
  border-bottom: 1px solid #d4e3eb;
}

.obs-featured-facts span {
  color: #7998ac;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
}

.obs-featured-facts strong {
  color: #1e4b68;
  font-size: 12px;
}

.obs-featured-actions {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
  margin-top: 31px;
}

.obs-featured-photo {
  margin: 0;
  min-height: 580px;
  display: flex;
  flex-direction: column;
  background: #06111d;
}

.obs-featured-photo img {
  flex: 1;
  width: 100%;
  min-height: 0;
  height: 530px;
  display: block;
  object-fit: cover;
}

.obs-featured-photo figcaption {
  padding: 19px 23px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  color: #bfd7e7;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .11em;
}

.obs-featured-photo a {
  color: #a9def9 !important;
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

/* WORKFLOW */

.obs-workflow {
  padding: 115px 0;
  background: #fff;
}

.obs-workflow-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 45px;
  margin-bottom: 48px;
}

.obs-workflow-head h2 {
  margin: 24px 0 0;
}

.obs-workflow-head > p {
  max-width: 345px;
  color: #6a8395;
  font-size: 14px;
  line-height: 1.85;
  margin: 0 0 10px;
}

.obs-workflow-grid {
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  gap: 18px;
  min-height: 445px;
}

.obs-workflow-primary {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 39px;
  color: #fff !important;
  background: #123e5e;
  transition: background .2s;
}

.obs-workflow-primary:hover {
  background: #0a314d;
}

.obs-workflow-primary > svg {
  color: #94d4f6;
}

.obs-workflow-number {
  font-size: 10px;
  letter-spacing: .15em;
  font-weight: 800;
  color: #6eb7e5;
}

.obs-workflow-primary h3 {
  color: #fff;
  font-size: 28px;
  margin: 0 0 13px;
  letter-spacing: -.05em;
}

.obs-workflow-primary p {
  color: #bfd5e3;
  max-width: 425px;
  font-size: 13px;
  line-height: 1.85;
}

.obs-workflow-primary span:last-child,
.obs-workflow-secondary a span:last-child {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 15px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .1em;
}

.obs-workflow-primary span:last-child {
  color: #a9dfff;
}

.obs-workflow-secondary {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 18px;
}

.obs-workflow-secondary > a {
  padding: 27px 32px;
  border: 1px solid #dce8f0;
  background: #f5f9fc;
  color: #123d5a;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  transition: background .2s;
}

.obs-workflow-secondary > a:hover {
  background: #eaf4fa;
}

.obs-workflow-secondary .obs-workflow-number {
  grid-column: 1 / -1;
}

.obs-workflow-secondary h3 {
  margin: 0 0 9px;
  font-size: 20px;
  letter-spacing: -.04em;
}

.obs-workflow-secondary p {
  color: #6c869a;
  font-size: 12px;
  line-height: 1.7;
  margin: 0;
}

.obs-workflow-secondary a span:last-child {
  color: #187ab8;
}

.obs-roadmap-note {
  margin-top: 20px;
  color: #8298aa;
  font-size: 11px;
  line-height: 1.8;
}

/* METHODOLOGY */

.obs-method {
  padding: 115px 0;
  background: #0c304b;
  color: #fff;
}

.obs-method-grid {
  display: grid;
  grid-template-columns: .88fr 1.12fr;
  gap: 110px;
  align-items: center;
}

.obs-method-intro h2 {
  color: #fff;
  margin: 29px 0;
  font-size: clamp(37px, 3.7vw, 55px);
}

.obs-method-intro h2 em {
  color: #92d7f9;
}

.obs-method-intro p {
  color: #b2cede;
  font-size: 14px;
  line-height: 1.9;
  max-width: 440px;
  margin-bottom: 31px;
}

.obs-method-list {
  border-top: 1px solid #42657d;
}

.obs-method-list > div {
  display: grid;
  grid-template-columns: 32px 28px 1fr;
  align-items: start;
  gap: 17px;
  padding: 29px 0;
  border-bottom: 1px solid #42657d;
}

.obs-method-list > div > span {
  color: #71c3ef;
  font-weight: 800;
  font-size: 14px;
}

.obs-method-list > div > svg {
  color: #92d7f9;
}

.obs-method-list h3 {
  color: #fff;
  font-size: 17px;
  margin: 0 0 9px;
}

.obs-method-list p {
  color: #b3cedd;
  font-size: 12px;
  line-height: 1.75;
  margin: 0;
}

/* FINAL SECTION */

.obs-final {
  padding: 120px 0;
  background: #f5f9fc;
}

.obs-final-grid {
  display: grid;
  grid-template-columns: 1.12fr .88fr;
  gap: 85px;
  align-items: center;
}

.obs-final h2 {
  margin: 26px 0;
}

.obs-final p {
  color: #658095;
  line-height: 1.85;
  font-size: 14px;
  max-width: 490px;
}

.obs-final .obs-button-primary {
  margin-top: 20px;
}

.obs-final-reference {
  background: #fff;
  padding: 39px;
  border: 1px solid #dce9f1;
  box-shadow: 0 15px 45px rgba(18, 57, 83, .05);
}

.obs-final-reference > span {
  color: #4485ac;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
}

.obs-final-line {
  margin: 24px 0;
  height: 1px;
  background: #d7e7f0;
}

.obs-final-reference strong {
  display: block;
  font-size: 23px;
  color: #153d5c;
  letter-spacing: -.05em;
  line-height: 1.45;
}

.obs-final-reference p {
  font-size: 12px;
  margin: 20px 0;
}

.obs-final-reference a {
  color: #177fbd !important;
  display: inline-flex;
  gap: 8px;
  align-items: center;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .1em;
}

/* RESPONSIVENESS */

@media (max-width: 1050px) {
  .obs-hero-grid,
  .obs-science-grid,
  .obs-featured-grid,
  .obs-method-grid,
  .obs-final-grid {
    gap: 35px;
  }

  .obs-hero-copy h1 {
    font-size: clamp(50px, 6vw, 70px);
  }

  .obs-data-inner {
    grid-template-columns: repeat(3, 1fr);
    padding: 30px 0;
  }
}

@media (max-width: 800px) {
  .obs-hero-grid,
  .obs-science-grid,
  .obs-featured-grid,
  .obs-workflow-grid,
  .obs-method-grid,
  .obs-final-grid {
    grid-template-columns: 1fr;
  }

  .obs-hero {
    padding-top: 55px;
  }

  .obs-hero-copy h1 {
    font-size: clamp(48px, 8vw, 68px);
  }

  .obs-photo-frame {
    height: 460px;
  }

  .obs-science,
  .obs-featured,
  .obs-workflow,
  .obs-method,
  .obs-final {
    padding: 80px 0;
  }

  .obs-featured-photo {
    min-height: 420px;
  }

  .obs-featured-photo img {
    height: 420px;
  }

  .obs-workflow-head {
    display: block;
  }

  .obs-workflow-head > p {
    margin-top: 26px;
    max-width: 540px;
  }

  .obs-workflow-primary {
    min-height: 340px;
  }
}

@media (max-width: 550px) {
  .obs-hero-copy h1 {
    font-size: clamp(42px, 11vw, 55px);
  }

  .obs-hero-description {
    font-size: 14px;
  }

  .obs-actions {
    display: grid;
  }

  .obs-photo-frame {
    height: 350px;
  }

  .obs-photo-top,
  .obs-photo-caption {
    font-size: 8px;
  }

  .obs-data-inner {
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }

  .obs-data-label {
    grid-column: 1 / -1;
  }

  .obs-source-link {
    grid-column: 1 / -1;
  }

  .obs-science,
  .obs-featured,
  .obs-workflow,
  .obs-method,
  .obs-final {
    padding: 65px 0;
  }

  .obs-home h2 {
    font-size: clamp(34px, 9vw, 44px);
  }

  .obs-featured-head > span:last-child {
    display: none;
  }

  .obs-featured-facts > div {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .obs-featured-photo {
    min-height: 350px;
  }

  .obs-featured-photo img {
    height: 350px;
  }

  .obs-workflow-primary {
    padding: 29px;
  }

  .obs-workflow-secondary > a {
    padding: 25px;
  }

  .obs-method-list > div {
    grid-template-columns: 27px 1fr;
  }

  .obs-method-list > div > svg {
    display: none;
  }

  .obs-final-reference {
    padding: 28px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .obs-home *,
  .obs-home *::before,
  .obs-home *::after {
    animation: none !important;
    transition: none !important;
  }
}
